BASE_URL=https://your-env-url.example.com
TEST_EMAIL=your_email@example.com
TEST_PASSWORD=your_password

# Qase Test Management
# Generate token at: https://app.qase.io/user/api/token
QASE_TESTOPS_API_TOKEN=your_qase_api_token
QASE_TESTOPS_PROJECT=DEMO
# Set to 'testops' to enable reporting, leave empty/off to disable
QASE_MODE=off
